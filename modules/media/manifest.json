{
  "name": "media",
  "scope": "chat",
  "summary": "查询当前会话最近消息里的图片/附件元数据",
  "entry": "run.mjs",
  "runtime": "node",
  "timeoutMs": 15000,
  "network": false,
  "actions": {
    "get_images": {
      "desc": "按 seq 或 messageId 查询消息中的图片/媒体清单",
      "params": {
        "messageId": { "type": "string", "required": false },
        "limit": { "type": "integer", "required": false }
      }
    },
    "get_forward": {
      "desc": "展开并读取一条合并转发消息的内容",
      "params": {
        "forwardId": { "type": "string", "required": true }
      }
    },
    "inspect_image": {
      "desc": "校验公网图片 URL 的格式与宽高尺寸",
      "params": {
        "url": { "type": "string", "required": true }
      }
    }
  }
}
