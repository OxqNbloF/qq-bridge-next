{
  "name": "wake",
  "scope": "chat",
  "summary": "查看并调节当前会话的拟人唤醒节奏与潜水周期",
  "entry": "run.mjs",
  "runtime": "node",
  "timeoutMs": 15000,
  "network": false,
  "actions": {
    "get_state": {
      "desc": "查看当前会话唤醒状态与未读概况",
      "params": {}
    },
    "set_config": {
      "desc": "设置当前会话唤醒模式 (sleep/active) 与间隔",
      "params": {
        "mode": { "type": "string", "required": false },
        "sleepMs": { "type": "integer", "required": false }
      }
    }
  }
}
