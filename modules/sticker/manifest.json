{
  "name": "sticker",
  "scope": "chat",
  "summary": "查看收藏表情列表、写备注与发送收藏表情",
  "entry": "run.mjs",
  "runtime": "node",
  "timeoutMs": 15000,
  "network": false,
  "actions": {
    "list": {
      "desc": "检索收藏表情库",
      "params": {
        "query": { "type": "string", "required": false },
        "limit": { "type": "integer", "required": false }
      }
    },
    "send": {
      "desc": "按表情 id 或备注发送表情",
      "params": {
        "ref": { "type": "string", "required": true }
      }
    },
    "note": {
      "desc": "为指定表情添加当前群备注",
      "params": {
        "id": { "type": "string", "required": true },
        "note": { "type": "string", "required": true }
      }
    }
  }
}
