{
  "name": "social",
  "scope": "chat",
  "summary": "群成员列表、活跃成员与轻互动（拍一拍）",
  "entry": "run.mjs",
  "runtime": "node",
  "timeoutMs": 15000,
  "network": false,
  "actions": {
    "group_members": {
      "desc": "查看当前群成员列表",
      "params": {
        "limit": { "type": "integer", "required": false }
      }
    },
    "active_members": {
      "desc": "查看近期发言活跃的成员",
      "params": {
        "limit": { "type": "integer", "required": false }
      }
    },
    "poke": {
      "desc": "在当前群聊轻拍某位成员",
      "params": {
        "userId": { "type": "string", "required": true }
      }
    }
  }
}
