{
  "name": "web",
  "scope": "chat",
  "summary": "带 SSRF 防护的安全网页检索与网页正文抓取",
  "entry": "run.mjs",
  "runtime": "node",
  "timeoutMs": 25000,
  "network": true,
  "actions": {
    "search": {
      "desc": "检索公网网页结果",
      "params": {
        "query": { "type": "string", "required": true },
        "maxResults": { "type": "integer", "required": false }
      }
    },
    "fetch": {
      "desc": "抓取消毒后的公网网页内容（拒绝一切内网与本机地址）",
      "params": {
        "url": { "type": "string", "required": true },
        "maxChars": { "type": "integer", "required": false }
      }
    }
  }
}
