{
  "name": "memory",
  "scope": "chat",
  "summary": "读取、保存与检索当前聊天和全局轻量记忆",
  "entry": "run.mjs",
  "runtime": "node",
  "timeoutMs": 15000,
  "network": false,
  "actions": {
    "list": {
      "desc": "列出近期记忆条目",
      "params": {
        "includeGlobal": { "type": "boolean", "required": false },
        "limit": { "type": "integer", "required": false }
      }
    },
    "save": {
      "desc": "保存一条精简记忆",
      "params": {
        "content": { "type": "string", "required": true },
        "tags": { "type": "array", "required": false },
        "scope": { "type": "string", "required": false }
      }
    },
    "delete": {
      "desc": "按 ID 删除一条记忆",
      "params": {
        "id": { "type": "string", "required": true }
      }
    },
    "search": {
      "desc": "按关键词检索记忆",
      "params": {
        "query": { "type": "string", "required": true },
        "limit": { "type": "integer", "required": false }
      }
    },
    "terms_list": {
      "desc": "列出本群与全局黑话词库",
      "params": {
        "limit": { "type": "integer", "required": false }
      }
    },
    "terms_search": {
      "desc": "按关键词检索黑话词条释义",
      "params": {
        "query": { "type": "string", "required": true },
        "limit": { "type": "integer", "required": false }
      }
    }
  }
}
