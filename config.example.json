{
  "ownerQQ": "",
  "console": {
    "host": "127.0.0.1",
    "port": 3100,
    "token": ""
  },
  "onebot": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": ""
  },
  "access": {
    "allowGroups": [],
    "allowPrivate": [],
    "denyGroups": [],
    "denyPrivate": [],
    "ignoreUsers": [],
    "allowAllWhenEmpty": false
  },
  "modes": {
    "defaultGroup": "human",
    "defaultPrivate": "chat",
    "chats": {}
  },
  "wake": {
    "coalesceMs": 2500,
    "cooldownMs": 45000,
    "minUnreadBatch": 6,
    "defaultSleepMs": 900000,
    "minSleepMs": 60000,
    "maxSleepMs": 7200000,
    "preSleepQuietMs": 120000,
    "mustWakeKeywords": []
  },
  "persona": {
    "name": "群友",
    "prompt": "你是一个真实自然的群聊成员，说话简短口语化；无关话题或不该插嘴时保持克制沉默。",
    "maxInjectChars": 4000,
    "injectEveryNWakes": 4,
    "maxInitialPromptChars": 1000
  },
  "gate": {
    "enabled": false
  },
  "identity": {
    "enabled": true,
    "learnFromChat": true,
    "exposeQqInPrompt": false,
    "maxAliasesPerUser": 8
  },
  "terms": {
    "enabled": true,
    "maxInject": 12
  },
  "media": {
    "maxBytes": 3145728,
    "maxPixels": 16777216,
    "maxForwardDepth": 3
  },
  "sticker": {
    "enabled": true,
    "maxInPrompt": 8
  },
  "voice": {
    "enabled": false,
    "dir": "data/voices",
    "maxBytes": 20971520,
    "maxPerMinute": 3,
    "maxPerDay": 20
  },
  "runtime": {
    "activeBackend": "agy",
    "activeModel": "",
    "maxConcurrent": 4,
    "turnTimeoutMs": 300000
  },
  "backends": {
    "dsh": {
      "baseUrl": "http://127.0.0.1:3080",
      "provider": "deepseek-official",
      "model": "deepseek-flash",
      "reasoningEffort": "max",
      "authToken": "",
      "allowRemote": false,
      "agentPreset": ""
    },
    "agy": {
      "command": "agy",
      "args": [],
      "model": "",
      "models": [],
      "timeoutMs": 300000,
      "permissions": {
        "allow": ["mcp(qq-broker/*)"],
        "deny": []
      }
    },
    "gemini": {
      "command": "gemini",
      "args": [],
      "model": "",
      "models": ["gemini-2.5-flash", "gemini-2.5-pro"],
      "timeoutMs": 300000
    },
    "cliProfiles": {
      "claude-example": {
        "label": "Claude Code (示例)",
        "command": "claude",
        "argsTemplate": ["-p", "{{prompt}}", "--output-format", "stream-json"],
        "modelFlag": "--model",
        "resumeFlag": "--resume",
        "outputFormat": "jsonl",
        "model": "",
        "models": ["sonnet", "opus"],
        "timeoutMs": 300000,
        "env": {}
      }
    }
  },
  "broker": {
    "enabledModules": ["msg", "memory", "wake", "media", "social", "web", "sticker", "voice"],
    "scriptTimeoutMs": 20000,
    "useBwrap": false
  },
  "prompt": {
    "compactThresholdTokens": 48000,
    "maxUnreadInline": 20
  },
  "security": {
    "blockSensitiveOutbound": true,
    "rateLimitPerMinute": 20,
    "maxBurstMessages": 4
  }
}
